generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cerdos {
  id     Int      @id @default(autoincrement())
  nombre String   @db.VarChar(100)
  peso   Decimal? @db.Decimal(6, 2)
}
